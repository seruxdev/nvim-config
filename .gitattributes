# =======================================
# Normalizar finales de línea
# =======================================

# Archivos de texto comunes
* text=auto

# Forzar LF para scripts y configuraciones
*.sh     text eol=lf
*.bash   text eol=lf
*.ps1    text eol=lf
*.json   text eol=lf
*.lua    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.md     text eol=lf

# Forzar CRLF para archivos de Windows específicos
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Ignorar binarios
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.tar    binary
*.gz     binary
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.otf    binary
*.ttf    binary

